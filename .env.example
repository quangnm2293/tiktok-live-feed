# Sao chép file này thành ".env" rồi điền giá trị thật.
# TUYỆT ĐỐI không chia sẻ file .env (chứa API key) cho ai.

# API key của EulerStream (đăng ký MIỄN PHÍ tại https://www.eulerstream.com).
# Euler chỉ dùng để KÝ request kết nối — sự kiện vẫn chảy thẳng từ TikTok.
EULER_API_KEY=

# Username TikTok của phòng live cần lấy sự kiện (KHÔNG có dấu @ ở đầu).
# Ví dụ: nếu phòng là tiktok.com/@abc/live thì điền: abc
TIKTOK_USERNAME=

# Cổng local cho game kết nối (mặc định 3010).
PORT=3010

# Bật log từng sự kiện ra console (1 = bật, để trống/0 = tắt).
# DEBUG_EVENTS=1

# Chế độ giả lập sự kiện để test game khi chưa có key (1 = bật).
# FEED_FAKE=1
