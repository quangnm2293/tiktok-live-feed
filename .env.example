# Sao chép file này thành ".env" rồi điền giá trị thật.
# TUYỆT ĐỐI không chia sẻ file .env cho ai.

# Username TikTok của phòng live cần lấy sự kiện (KHÔNG có dấu @ ở đầu).
# Ví dụ: nếu phòng là tiktok.com/@abc/live thì điền: abc
TIKTOK_USERNAME=

# Tuyến ký kết nối TikTok:
#   local  = MÁY KÝ TỰ HOST (MẶC ĐỊNH — để trống cũng là local).
#            Không cần key Euler, không phụ thuộc EulerStream.
#            Cần máy có Google Chrome (hoặc đặt SIGN_CHROME_PATH).
#   euler  = fallback cũ: EulerStream ký bằng EULER_API_KEY bên dưới.
#            LƯU Ý: route ký của Euler hiện bị khóa sau gói Business
#            (key miễn phí bị từ chối) — chỉ dùng khi đã có gói trả phí.
SIGN_MODE=local

# API key của EulerStream — CHỈ cần khi SIGN_MODE=euler.
EULER_API_KEY=

# Đường dẫn file chạy Chrome/Chromium cho máy ký local (tuỳ chọn).
# Để trống = tự tìm: Google Chrome cài sẵn trên Mac/Windows/Linux,
# hoặc bản Chrome trong ~/.cache/puppeteer.
# SIGN_CHROME_PATH=

# Cổng local cho game kết nối (mặc định 3010).
PORT=3010

# Bật log từng sự kiện ra console (1 = bật, để trống/0 = tắt).
# DEBUG_EVENTS=1

# Chế độ giả lập sự kiện để test game khi chưa có key (1 = bật).
# FEED_FAKE=1
